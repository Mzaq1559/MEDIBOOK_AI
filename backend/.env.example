# Database Configuration
DATABASE_URL=postgresql://medibook:password123@localhost:5432/medibook_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security & Authentication
SECRET_KEY=your-super-secret-jwt-key-must-be-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1

# AI Service Integration
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768

# Calendar Integration
GOOGLE_CALENDAR_API_KEY=your-google-api-key-here
GOOGLE_CALENDAR_SECRET=your-google-secret-here

# Notifications (Email & WhatsApp)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@primecare.pk
SMTP_PASSWORD=app-password-here
WHATSAPP_API_TOKEN=your-whatsapp-token-here
WHATSAPP_BUSINESS_ACCOUNT_ID=your-account-id-here

# Application & CORS
ENVIRONMENT=development
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Logging
LOG_LEVEL=INFO
