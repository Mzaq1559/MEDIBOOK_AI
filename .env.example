# ── Docker Compose Environment ──
# Copy this file to .env and fill in real values.
# This file is read by docker-compose for variable interpolation.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Backend secrets
SECRET_KEY=your-secret-jwt-key-at-least-32-characters-long
DATABASE_URL=postgresql://medibook:password123@db:5432/medibook_db

# SMTP (optional — leave blank to skip email notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
