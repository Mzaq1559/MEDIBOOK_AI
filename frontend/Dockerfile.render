# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files and install dependencies
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

# Build-time ARGs — Vite inlines VITE_* vars into the static bundle at build time
ARG VITE_API_URL
ARG VITE_CHAT_API_URL
ARG VITE_PROXY_BACKEND
ARG VITE_PROXY_AI_SERVICE
ARG VITE_APP_NAME="MediBook AI"
ARG VITE_APP_VERSION="1.0.0"

# Expose as ENV so vite.config.ts can read them during `npm run build`
ENV VITE_API_URL=$VITE_API_URL \
    VITE_CHAT_API_URL=$VITE_CHAT_API_URL \
    VITE_PROXY_BACKEND=$VITE_PROXY_BACKEND \
    VITE_PROXY_AI_SERVICE=$VITE_PROXY_AI_SERVICE \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_APP_VERSION=$VITE_APP_VERSION

COPY . .
RUN npm run build

# ── Stage 2: Serve (vite preview) ────────────────────────────────────────────
FROM node:18-alpine

WORKDIR /app

# Copy production build artifacts and node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/vite.config.ts ./vite.config.ts
COPY --from=builder /app/tsconfig.json ./tsconfig.json

# Runtime proxy targets — vite preview reads these from env at startup
ENV VITE_PROXY_BACKEND=https://medibook-backend.onrender.com \
    VITE_PROXY_AI_SERVICE=https://medibook-ai-service.onrender.com

# Render uses PORT (default 10000)
EXPOSE 10000

# Serve production build with vite preview (includes proxy middleware from vite.config.ts)
CMD ["sh", "-c", "npx vite preview --host 0.0.0.0 --port ${PORT:-10000}"]
