# Relative paths — the Vite dev server proxies these to backend / AI service.
VITE_API_URL=/api
VITE_CHAT_API_URL=/chat

VITE_APP_NAME=MediBook AI
VITE_APP_VERSION=1.0.0

# Proxy targets (used by vite.config.ts only; set in docker-compose for containers)
# VITE_PROXY_BACKEND=http://backend:8000
# VITE_PROXY_AI_SERVICE=http://ai-service:8001
